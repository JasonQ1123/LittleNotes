generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  nickname     String
  avatarKey    String?
  passwordHash String
  email        String?  @unique
  emailVerifiedAt DateTime?
  authVersion  Int      @default(0)
  spaceId      String?
  space        Space?   @relation(fields: [spaceId], references: [id])
  sessions     Session[]
  memberships  SpaceMembership[]
  createdAt    DateTime @default(now())
  @@index([spaceId])
}

model Session {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}

model PasswordChangeLimit {
  key       String   @id
  count     Int
  expiresAt DateTime
  @@index([expiresAt])
}

model EmailChallenge {
  id          String   @id
  email       String
  purpose     String
  userId      String?
  authVersion Int?
  digest      String?
  attempts    Int      @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())
  job         EmailJob?
  @@index([email, purpose])
  @@index([userId])
  @@index([expiresAt])
}

model EmailJob {
  id          String   @id
  challenge   EmailChallenge @relation(fields: [id], references: [id], onDelete: Cascade)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  @@index([status, createdAt])
}

model EmailLimit {
  key         String   @id
  count       Int
  expiresAt   DateTime
  @@index([expiresAt])
}

model Space {
  id          String       @id @default(cuid())
  name        String
  members     User[]
  invitations Invitation[]
  records     Record[]
  createdAt   DateTime     @default(now())
  status      String       @default("active")
  lifecycleVersion Int     @default(1)
  closedAt    DateTime?
  closedById  String?
  purgeAt     DateTime?
  memberships SpaceMembership[]
  restoreRequests SpaceRestoreRequest[]
  @@index([status, purgeAt])
}

model SpaceMembership {
  spaceId String
  userId String
  nicknameSnapshot String
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
  @@id([spaceId, userId])
  @@index([userId])
}

model SpaceRestoreRequest {
  id String @id @default(cuid())
  spaceId String
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  requestedById String
  requesterAuthVersion Int
  lifecycleVersion Int
  status String @default("pending")
  createdAt DateTime @default(now())
  expiresAt DateTime
  resolvedAt DateTime?
  @@index([spaceId, status])
}

model Invitation {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id])
  creatorId  String
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  @@index([spaceId])
}

model Record {
  id              String           @id @default(cuid())
  spaceId         String
  space           Space            @relation(fields: [spaceId], references: [id])
  authorId        String
  title           String
  occurredAt      DateTime         @default(now())
  description     String           @default("")
  category        String           @default("其他")
  tagsJson        String           @default("[]")
  status          String           @default("draft")
  revision        Int              @default(1)
  perspectives    Perspective[]
  agreements      Agreement[]
  reconciliations Reconciliation[]
  archiveVotes    ArchiveVote[]
  relatedTo       RecordLink[]     @relation("LinkSource")
  relatedFrom     RecordLink[]     @relation("LinkTarget")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  @@index([spaceId, occurredAt])
  @@index([spaceId, status])
}

model Perspective {
  id            String   @id @default(cuid())
  recordId      String
  record        Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  userId        String
  draftJson     String   @default("{}")
  publishedJson String?
  publishedAt   DateTime?
  revision      Int      @default(1)
  updatedAt     DateTime @updatedAt
  @@unique([recordId, userId])
}

model Agreement {
  id             String                  @id @default(cuid())
  recordId       String
  record         Record                  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  version        Int
  status         String                  @default("pending")
  understanding  String
  actionsJson    String
  criteria       String
  requestedDueAt DateTime?
  proposedById   String
  activatedAt    DateTime?
  confirmations  AgreementConfirmation[]
  cycles         ReviewCycle[]
  createdAt      DateTime                @default(now())
  @@unique([recordId, version])
}

model AgreementConfirmation {
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  userId      String
  confirmedAt DateTime  @default(now())
  @@id([agreementId, userId])
}

model ReviewCycle {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  number      Int
  dueAt       DateTime
  reviews     Review[]
  createdAt   DateTime  @default(now())
  @@unique([agreementId, number])
}

model Review {
  id          String      @id @default(cuid())
  cycleId     String
  cycle       ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  userId      String
  rating      String
  achieved    String
  example     String      @default("")
  remaining   String      @default("")
  adjustments String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@unique([cycleId, userId])
}

model Reconciliation {
  recordId String
  record   Record  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  userId   String
  value    Boolean @default(true)
  @@id([recordId, userId])
}

model ArchiveVote {
  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  userId   String
  @@id([recordId, userId])
}

model RecordLink {
  recordId  String
  relatedId String
  record    Record @relation("LinkSource", fields: [recordId], references: [id], onDelete: Cascade)
  related   Record @relation("LinkTarget", fields: [relatedId], references: [id], onDelete: Cascade)
  @@id([recordId, relatedId])
}
