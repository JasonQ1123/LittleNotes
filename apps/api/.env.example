DATABASE_URL="file:./dev.db"
PORT=3000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
AI_ENABLED=false
EMAIL_DELIVERY=mock
# 本地也建议生成固定独立密钥，避免重启使尚未使用的验证码失效。
EMAIL_HMAC_SECRET=
# EMAIL_DELIVERY=smtp 时必须设置（真实发信前请先验证投递）。
SMTP_USER=
SMTP_AUTH_CODE=
EMAIL_COOLDOWN_SECONDS=60
EMAIL_LIMIT_EMAIL_HOUR=5
EMAIL_LIMIT_EMAIL_DAY=10
EMAIL_LIMIT_IP_HOUR=20
EMAIL_LIMIT_GLOBAL_DAY=200
