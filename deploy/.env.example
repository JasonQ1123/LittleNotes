# 在服务器执行 bash deploy/configure.sh 自动生成 .env，不要把实际密码提交到 Git。
POSTGRES_PASSWORD=replace_with_generated_hex_password
WEB_ORIGIN=https://web.littlenotes.cn
DOMAIN=web.littlenotes.cn
ACME_EMAIL=
ICP_NUMBER=沪ICP备2026047310号
# 163 邮箱设置中开通 SMTP，下面填写授权码而非邮箱密码。
SMTP_USER=
SMTP_AUTH_CODE=
# openssl rand -hex 32；独立生成，不复用数据库密码。
EMAIL_HMAC_SECRET=
# 仅在服务器真实投递且确认 QQ、163 均收信后设置为 1。
EMAIL_SMTP_VERIFIED=0
EMAIL_COOLDOWN_SECONDS=60
EMAIL_LIMIT_EMAIL_HOUR=5
EMAIL_LIMIT_EMAIL_DAY=10
EMAIL_LIMIT_IP_HOUR=20
EMAIL_LIMIT_GLOBAL_DAY=200
